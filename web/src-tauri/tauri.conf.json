{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Novel Hub",
  "version": "0.3.0",
  "identifier": "com.novelhub.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3001",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' http://127.0.0.1:17831 http://127.0.0.1:8000; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Novel Hub",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "targets": ["nsis", "msi"],
    "externalBin": ["binaries/novelhub-sidecar"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
